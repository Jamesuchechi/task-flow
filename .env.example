APP_NAME="TaskFlow API"
APP_VERSION="0.3.0"

# Database (SQLite for local dev; use postgresql+asyncpg://user:pass@localhost:5432/taskflow for Postgres)
DATABASE_URL="sqlite+aiosqlite:///./taskflow.db"
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./taskflow.db"

# Security / JWT (replace with a strong random secret)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Caching (optional Redis URL; falls back to in-memory TTL cache when unset)
# REDIS_URL="redis://localhost:6379/0"
CACHE_DEFAULT_TTL_SECONDS=60

# File Uploads & Background Exports
UPLOAD_DIR="uploads"
EXPORT_DIR="exports"
MAX_UPLOAD_SIZE_BYTES=10485760

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
